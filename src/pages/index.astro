---
import { img, share } from '../lib/media';
/* About: the author's photograph, name and line beside a brain drawn in
   smooth curves. Then one sentence to a screen, and one cast of strokes (rings,
   the world's circle, its people, a line, compass arcs, ripples) that
   turns from scene to scene, each change saying what the sentence says:
   the rings knot, the knot tightens into the author, a line stops short,
   a compass bridges it, words and a spiral, arches, people left unfinished,
   ripples too strong on one side, then measured lines to each person. The
   author is one small circle in the signal colour, in every scene. */
import Layout from '../layouts/Layout.astro';

// One sentence to a screen; the picture takes one step with each.
const acts = [
  { say: "For a long time I felt I was too complicated to explain, and the world too complicated to understand, and it cost me a great deal." },
  { say: "In truth, the complexity was never the problem; what I lacked was a way to communicate, and a way to understand." },
  { say: "This site is my attempt to build both, starting with the way my mind already works." },
  { say: "It thinks in images far more readily than in words." },
  { say: "That is why fields built on seeing, such as computer vision (where I earn my living), architecture, visual art and fine cinematography, have always drawn me in." },
  { say: "But not everything shows itself to the eye: a building or a frame I can picture, but people are harder, because I struggle to understand emotions, and even more to manage them." },
  { say: "In practice it swings between extremes: either I feel something far too strongly, or I fail to register my own feelings and those of the people around me." },
  { say: "So I try to understand them the way I understand anything else: I read psychology and neuroscience, think it through, and slowly they become a little easier to see." },
  { say: "I may never fully explain myself or understand the people and the world around me, but this site is where I keep trying, and that is my <span class=\"act-brand\">Journey of <em>Curiosity</em></span>" },
];
const links = [
  { label: 'GitHub', href: 'https://github.com/Arshad221b' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/arshad221b/' },
  { label: 'Substack', href: 'https://substack.com/@arshadkazi' },
  { label: 'Email', href: 'mailto:arshadkaziblog@gmail.com' },
];
const title = 'Arshad Kazi — Computer vision engineer and writer';
---
<Layout title={title} activeNav="/" description="Arshad Kazi is an engineer in computer vision. Notebooks and technical writing on vision, the brain and machine learning, and personal essays." ogImage={share("/images/share-about.jpg")}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Arshad Kazi",
    "url": "https://arshad-kazi.com",
    "jobTitle": "Engineer in computer vision",
    "description": "Notebooks, technical writing and personal essays.",
    "sameAs": [
      "https://github.com/Arshad221b",
      "https://www.linkedin.com/in/arshad221b/",
      "https://medium.com/@arshad_221b",
      "https://substack.com/@arshadkazi"
    ]
  })} />

  <div class="ab wide" id="ab">
    <section class="stage" id="stage" aria-label="One set of fourteen lines that redraws itself with each sentence: a brain, a tangle, a line stopping short of a larger circle, a compass construction bridging it, words and a spiral, arches in perspective, people as unclosed circles, ripples, and measured lines to each person">
      <div class="pin">
        <canvas id="pts" aria-hidden="true"></canvas>
        <!-- Who: the photograph, the name and the line, beside the roll. -->
        <div class="who on" id="who">
          <span class="who-print">
            <img src={img('/images/profile.jpg', 600)} alt="Arshad Kazi" width="480" height="600" draggable="false" />
          </span>
          <h1 class="mast-title who-name">Arshad <em>Kazi</em></h1>
          <p class="who-role">Engineer in computer vision; I also write essays.</p>
          <p class="who-links" data-nosnippet>
            {links.map(l => {
              const mail = l.href.startsWith('mailto');
              return <a href={l.href} target={mail ? undefined : '_blank'} rel="noopener">{l.label}<span aria-hidden="true">{mail ? '→' : '↗'}</span></a>;
            })}
          </p>
        </div>
        {acts.map((a, i) => (
          <div class="act" data-i={i}>
            <div class="act-text">
              <p class="act-say" set:html={a.say} />
            </div>
          </div>
        ))}
        <p class="act-hint" aria-hidden="true">Scroll <span>&darr;</span></p>
        <ol class="act-ticks" aria-hidden="true">{acts.map(() => <li></li>)}</ol>
      </div>
    </section>
  </div>
</Layout>

<style>
  :global(body:has(.ab) main) { padding-top: 0; padding-bottom: 0; }
  .ab { margin-inline: calc(-1 * var(--axis)); }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* About a third of a screen of scroll per sentence; one screen of
     picture, pinned. */
  .stage { position: relative; height: 420vh; height: 420svh; }
  .pin {
    position: sticky;
    top: var(--head-h, 4.5rem);
    height: calc(100vh - var(--head-h, 4.5rem));
    height: calc(100svh - var(--head-h, 4.5rem));
    overflow: hidden;
  }
  #pts {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .act {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* ── Who: the first screen's left side ── */
  .who {
    position: absolute;
    left: var(--axis);
    bottom: var(--space-2xl);
    z-index: 2;
    opacity: 0;
    transform: translateY(var(--space-4));
    /* Leaving is quick, so it is gone before the act's words arrive in the
       same corner; arriving waits for whatever was there to leave. */
    transition: opacity var(--dur-fast) ease, transform var(--dur-fast) ease;
    pointer-events: none;
  }
  .who.on {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition: opacity 0.6s var(--ease-out) var(--dur-base), transform 0.6s var(--ease-out) var(--dur-base);
  }
  .who-print {
    display: block;
    width: clamp(6.5rem, 9vw, 8.75rem);
    margin: 0 0 var(--space-xl) var(--space-1);
    padding: var(--space-1-5) var(--space-1-5) var(--space-4);
    background: var(--color-raised);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lift);
    transform: rotate(-2.5deg);
    transition: transform 0.6s var(--ease-out);
  }
  .who-print:hover { transform: rotate(0deg) translateY(calc(-1 * var(--space-1))); }
  .who-print img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
    filter: grayscale(1) contrast(1.08);
    transition: filter 0.7s ease;
    user-select: none;
    -webkit-user-drag: none;
  }
  .who-print:hover img { filter: none; }
  .who-name { white-space: nowrap; padding-right: 0.22em; }
  .who-role {
    margin: var(--space-4) 0 var(--space-lg);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-body);
    color: var(--color-text-secondary);
  }
  .who-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5) var(--space-6);
    margin: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    width: fit-content;
    min-width: min(100%, 22rem);
  }
  .who-links a {
    display: inline-flex;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--dur-base) ease;
  }
  .who-links a span { color: var(--color-accent); }
  .who-links a:hover { color: var(--color-accent); text-decoration: none; }


  /* ── The acts: composed as a spread ──
     Wide screens: the sentence in a left column on the axis, centred in
     the height; the picture centred in the space to its right. A hairline
     strip along the foot carries where you are (left) and the cue to
     scroll (right). Phones: the picture in the top half, the sentence
     always starting at the same height below it, the marks just above. */
  .act-text {
    position: absolute;
    left: var(--axis);
    top: 0;
    bottom: 0;
    /* Centred in the height by flex, which every browser handles. */
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(28rem, 34vw);
    opacity: 0;
    transform: translateY(var(--space-3));
    transition: opacity var(--dur-fast) ease, transform var(--dur-fast) ease;
  }
  .act.on .act-text {
    opacity: 1;
    transform: none;
    transition: opacity 0.7s var(--ease-out) var(--dur-base), transform 0.7s var(--ease-out) var(--dur-base);
  }

  /* The site's name, said in the last sentence, set as the title is. */
  .act-say :global(.act-brand) {
    font-family: 'Great Vibes', var(--font-serif);
    font-style: normal;
    font-weight: var(--fw-regular);
    font-synthesis: none;
    /* Its own line, larger than the sentence: the story signs off with
       the site's name. */
    display: block;
    margin-top: 0.3em;
    font-size: 1.75em;
    letter-spacing: var(--track-normal);
    line-height: var(--lh-tight);
    white-space: nowrap;
  }
  .act-say :global(.act-brand em) { font-style: normal; color: var(--color-accent); }
  .act-say {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: var(--fw-light);
    line-height: var(--lh-snug);
    letter-spacing: var(--track-snug);
    text-wrap: pretty;
    color: var(--color-text);
    /* Paper feathered under the words, so no point crosses them. */
    text-shadow: 0 0 var(--space-4) var(--color-bg), 0 0 var(--space-2) var(--color-bg), 0 0 var(--space-1) var(--color-bg);
  }

  .act-hint {
    position: absolute;
    right: var(--axis);
    bottom: var(--space-xl);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-none);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: opacity var(--dur-slow) ease;
  }
  .act-hint span { color: var(--color-accent); }
  .act-hint.gone { opacity: 0; }

  /* Where you are: one short mark per act, the current one drawn long in
     the signal colour. Hidden while the name has the screen. */
  .act-ticks {
    position: absolute;
    left: var(--axis);
    bottom: calc(var(--space-xl) + var(--space-1));
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    transition: opacity var(--dur-slow) ease;
  }
  .who.on ~ .act-ticks { opacity: 0; }
  .act-ticks li {
    width: var(--space-4);
    height: 1px;
    margin: 0;
    background: var(--color-text-muted);
    transition: width var(--dur-slow) var(--ease-out), background-color var(--dur-base) ease;
  }
  .act-ticks li.on { width: var(--space-10); background: var(--color-accent); }

  @media (prefers-reduced-motion: reduce) {
    .act-text, .act.on .act-text, .who, .who.on { transition: none; }
  }
  @media (max-width: 760px) {
    .act-text {
      top: auto;
      bottom: calc(var(--space-lg) + var(--space-6));
      display: block;
      width: auto;
      right: var(--axis);
    }
    .act-say { font-size: var(--fs-act); }
    .act-ticks { bottom: var(--space-lg); }
    .act-hint { display: none; }
    .who-print { width: 6rem; margin-bottom: var(--space-lg); }
    .who { bottom: var(--space-xl); right: var(--axis); }
  }
</style>

<script is:inline>
(function () {
  var stage = document.getElementById('stage');
  var canvas = document.getElementById('pts');
  if (!stage || !canvas) return;
  var g = canvas.getContext('2d');
  var pin = canvas.parentElement;
  var acts = [].slice.call(stage.querySelectorAll('.act'));
  var ticks = [].slice.call(stage.querySelectorAll('.act-ticks li'));
  var hint = stage.querySelector('.act-hint');
  var who = document.getElementById('who');
  var N = acts.length;
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Colour, from the page's own tokens ── */
  function rgb(c) {
    c = c.trim();
    if (c[0] === '#') {
      if (c.length === 4) c = '#' + c[1] + c[1] + c[2] + c[2] + c[3] + c[3];
      return [parseInt(c.slice(1, 3), 16), parseInt(c.slice(3, 5), 16), parseInt(c.slice(5, 7), 16)];
    }
    var m = c.match(/[\d.]+/g) || [0, 0, 0];
    return [+m[0], +m[1], +m[2]];
  }
  function mixc(a, b, t) { return [a[0] * t + b[0] * (1 - t), a[1] * t + b[1] * (1 - t), a[2] * t + b[2] * (1 - t)]; }
  function css(c) { return 'rgb(' + Math.round(c[0]) + ',' + Math.round(c[1]) + ',' + Math.round(c[2]) + ')'; }
  var pal;
  function palette() {
    var cs = getComputedStyle(document.documentElement);
    var bg = rgb(cs.getPropertyValue('--color-bg')), ac = rgb(cs.getPropertyValue('--color-accent'));
    var tx = rgb(cs.getPropertyValue('--color-text')), mu = rgb(cs.getPropertyValue('--color-text-muted'));
    var cols = [];
    for (var i = 0; i < 16; i++) {
      var t = i / 15;
      // Ink at one end of the manifold, through warm grey, to the signal.
      var c = t < 0.55 ? mixc(mu, tx, t / 0.55 * 0.8 + 0.2) : mixc(ac, mu, (t - 0.55) / 0.45 * 0.85 + 0.15);
      cols.push(css(c));
    }
    pal = { bg: css(bg), cols: cols, ink: css(mixc(tx, bg, 0.78)), accent: css(mixc(ac, bg, 0.92)), line: css(mixc(tx, bg, 0.16)), dust: css(mixc(mu, bg, 0.5)), edge: css(mixc(ac, bg, 0.35)) };
  }

  /* ── Nine drawings, one set of lines ──
     The drawings are made of circles, straight lines and smooth curves at
     one weight. Every drawing is the same fourteen continuous lines, all
     of them always visible: between drawings nothing fades and nothing is
     erased; each line moves and bends into its place in the next drawing,
     going to the nearest line there, from its nearer end. One small circle
     in the signal colour is the author, in every drawing. Units: about 2.6
     across, 2 down. */
  var SH = [], started = false, NP = 240, K = 28;
  var regB = 0, colL = 0, colW = 0;
  var W = 0, H = 0, dpr = 1;
  var yaw = 0, tyaw = 0, pit = 0, tpit = 0, raf = 0, prog = 0, cur = 0, last = 0, born = performance.now();

  // Lines as point lists.
  function seg(x1, y1, x2, y2) { return [[x1, y1], [x2, y2]]; }
  function arcP(x, y, r, a0, sweep) {
    var n = Math.max(24, Math.ceil(Math.abs(sweep) * r * 160)), o = [];
    for (var i = 0; i <= n; i++) { var a = a0 + sweep * i / n; o.push([x + Math.cos(a) * r, y + Math.sin(a) * r]); }
    return o;
  }
  function ringP(x, y, r) { return arcP(x, y, r, -Math.PI / 2, Math.PI * 2); }
  // A straight line with short ticks across it at the given distances,
  // each tick drawn out and back, so the line stays one stroke.
  function ticked(x1, y1, x2, y2, at, h) {
    var L = Math.hypot(x2 - x1, y2 - y1), ux = (x2 - x1) / L, uy = (y2 - y1) / L, nx = -uy * h, ny = ux * h, o = [[x1, y1]];
    at.forEach(function (d) {
      var px = x1 + ux * d, py = y1 + uy * d;
      o.push([px, py], [px + nx, py + ny], [px - nx, py - ny], [px, py]);
    });
    o.push([x2, y2]);
    return o;
  }
  function lenOf(p) { var s = 0; for (var i = 1; i < p.length; i++) s += Math.hypot(p[i][0] - p[i - 1][0], p[i][1] - p[i - 1][1]); return s; }
  // Split a line in two at half its length.
  function halve(p) {
    var half = lenOf(p) / 2, acc = 0;
    for (var i = 1; i < p.length; i++) {
      var d = Math.hypot(p[i][0] - p[i - 1][0], p[i][1] - p[i - 1][1]);
      if (acc + d >= half) {
        var t = (half - acc) / (d || 1), m = [lerp(p[i - 1][0], p[i][0], t), lerp(p[i - 1][1], p[i][1], t)];
        return [p.slice(0, i).concat([m]), [m].concat(p.slice(i))];
      }
      acc += d;
    }
    return [p, p];
  }
  // Evenly along the line, NP points.
  function fit(p) {
    var L = [0];
    for (var i = 1; i < p.length; i++) L.push(L[i - 1] + Math.hypot(p[i][0] - p[i - 1][0], p[i][1] - p[i - 1][1]));
    var tot = L[L.length - 1] || 1, out = [], j = 1;
    for (var k = 0; k < NP; k++) {
      var d = tot * k / (NP - 1);
      while (j < p.length - 1 && L[j] < d) j++;
      var t = (d - L[j - 1]) / ((L[j] - L[j - 1]) || 1);
      out.push([lerp(p[j - 1][0], p[j][0], t), lerp(p[j - 1][1], p[j][1], t)]);
    }
    return out;
  }
  function centre(p) { var x = 0, y = 0; p.forEach(function (q) { x += q[0]; y += q[1]; }); return [x / p.length, y / p.length]; }
  function closed(p) { return Math.hypot(p[0][0] - p[NP - 1][0], p[0][1] - p[NP - 1][1]) < 1e-3; }

  // A drawing: its lines brought to exactly K by halving the longest, then
  // each matched to the nearest line of the drawing before, from the
  // nearer end, so the change between them is short and untangled.
  function scene(me, lines, prev) {
    lines = lines.slice();
    while (lines.length < K) {
      var li = 0;
      lines.forEach(function (p, i) { if (lenOf(p) > lenOf(lines[li])) li = i; });
      var h = halve(lines[li]); lines.splice(li, 1, h[0], h[1]);
    }
    var S = lines.map(fit);
    if (!prev) return { me: me, s: S };
    var pc = prev.s.map(centre), sc = S.map(centre), pairs = [];
    pc.forEach(function (a, i) { sc.forEach(function (b, j) { pairs.push([Math.hypot(a[0] - b[0], a[1] - b[1]), i, j]); }); });
    pairs.sort(function (m, n) { return m[0] - n[0]; });
    var out = new Array(K), usedP = {}, usedS = {};
    pairs.forEach(function (q) { if (!usedP[q[1]] && !usedS[q[2]]) { usedP[q[1]] = usedS[q[2]] = 1; out[q[1]] = S[q[2]]; } });
    out = out.map(function (p, i) {
      var a = prev.s[i];
      if (closed(p)) {
        // A closed line starts at its point nearest the old line's start.
        var bi = 0, bd = 9;
        for (var t = 0; t < NP - 1; t++) { var dd = Math.hypot(p[t][0] - a[0][0], p[t][1] - a[0][1]); if (dd < bd) { bd = dd; bi = t; } }
        p = p.slice(bi, NP - 1).concat(p.slice(0, bi)); p.push(p[0]);
        p = fit(p);
      } else {
        var keep = Math.hypot(p[0][0] - a[0][0], p[0][1] - a[0][1]) + Math.hypot(p[NP - 1][0] - a[NP - 1][0], p[NP - 1][1] - a[NP - 1][1]);
        var flip = Math.hypot(p[NP - 1][0] - a[0][0], p[NP - 1][1] - a[0][1]) + Math.hypot(p[0][0] - a[NP - 1][0], p[0][1] - a[NP - 1][1]);
        if (flip < keep) p = p.slice().reverse();
      }
      return p;
    });
    return { me: me, s: out };
  }

  var FOLK = [[0.72, -0.55, 0.22], [1.0, 0.1, 0.16], [0.62, 0.62, 0.25], [-0.15, 0.72, 0.14], [-0.82, 0.5, 0.2], [-0.95, -0.35, 0.17], [-0.3, -0.72, 0.21]];

  function build() {
    var i, k, P;
    SH = [];
    // 0. The author alone: a brain in profile, in smooth curves only: its
    // outline, the central and lateral folds, the folds of each lobe, the
    // cerebellum and its layers, the brainstem. The author's circle sits in
    // the front of it, where thinking is done.
    function smooth(pts, loop) {
      var o = [], n = pts.length, segs = loop ? n : n - 1;
      for (var a = 0; a < segs; a++) {
        var p0 = pts[loop ? (a - 1 + n) % n : Math.max(0, a - 1)], p1 = pts[a], p2 = pts[(a + 1) % n], p3 = pts[loop ? (a + 2) % n : Math.min(n - 1, a + 2)];
        for (var b = a ? 1 : 0; b <= 24; b++) {
          var t = b / 24, t2 = t * t, t3 = t2 * t;
          o.push([0.5 * (2 * p1[0] + (-p0[0] + p2[0]) * t + (2 * p0[0] - 5 * p1[0] + 4 * p2[0] - p3[0]) * t2 + (-p0[0] + 3 * p1[0] - 3 * p2[0] + p3[0]) * t3),
                  0.5 * (2 * p1[1] + (-p0[1] + p2[1]) * t + (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * t2 + (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * t3)]);
        }
      }
      return o;
    }
    var C = function (pts) { return smooth(pts, false); };
    P = [
      // The hemisphere's outline: frontal pole, the vault, the occipital
      // pole, the temporal lobe beneath with its pole, the orbital surface.
      smooth([[-1.12, -0.05], [-1.06, -0.38], [-0.84, -0.63], [-0.46, -0.79], [-0.02, -0.83], [0.42, -0.77], [0.78, -0.6], [1.02, -0.36],
              [1.15, -0.08], [1.1, 0.12], [0.95, 0.2], [0.62, 0.22], [0.36, 0.32], [0.05, 0.42], [-0.28, 0.44], [-0.52, 0.37],
              [-0.61, 0.23], [-0.56, 0.11], [-0.74, 0.12], [-0.99, 0.09]], true),
      // The lateral (Sylvian) fissure and its two short branches.
      C([[-0.56, 0.11], [-0.26, 0.01], [0.1, -0.09], [0.36, -0.18], [0.46, -0.31]]),
      C([[-0.36, 0.04], [-0.42, -0.06], [-0.44, -0.12]]),
      C([[-0.46, 0.07], [-0.56, 0.02], [-0.62, 0.0]]),
      // The central sulcus, and the sulci either side of it.
      C([[0.05, -0.83], [-0.03, -0.62], [0.06, -0.46], [-0.04, -0.31], [0.02, -0.14]]),
      C([[-0.22, -0.79], [-0.29, -0.56], [-0.2, -0.43], [-0.27, -0.22]]),
      C([[0.26, -0.77], [0.18, -0.56], [0.27, -0.41], [0.2, -0.24]]),
      // Superior and inferior frontal sulci.
      C([[-0.29, -0.58], [-0.5, -0.62], [-0.72, -0.53], [-0.92, -0.5]]),
      C([[-0.27, -0.31], [-0.5, -0.3], [-0.73, -0.22], [-0.95, -0.23]]),
      // The intraparietal sulcus.
      C([[0.22, -0.42], [0.45, -0.43], [0.63, -0.35], [0.82, -0.39], [0.96, -0.23]]),
      // Superior and inferior temporal sulci.
      C([[-0.43, 0.23], [-0.1, 0.13], [0.25, 0.06], [0.55, -0.02], [0.74, -0.1]]),
      C([[-0.31, 0.35], [0.0, 0.29], [0.3, 0.23], [0.56, 0.15]]),
      // Parieto-occipital and occipital sulci.
      C([[0.84, -0.56], [0.92, -0.41], [1.02, -0.43]]),
      C([[0.97, -0.05], [0.86, 0.05], [0.99, 0.13]]),
      // Shorter folds between.
      C([[-0.62, -0.72], [-0.5, -0.67], [-0.4, -0.72]]),
      C([[-0.88, -0.36], [-0.74, -0.4], [-0.62, -0.37]]),
      C([[0.5, -0.66], [0.6, -0.58], [0.66, -0.64]]),
      C([[0.4, -0.2], [0.5, -0.12], [0.56, -0.2]]),
      C([[0.66, -0.2], [0.76, -0.1], [0.84, -0.16]]),
      // The cerebellum, and its fine folia.
      smooth([[0.55, 0.3], [0.85, 0.23], [1.08, 0.29], [1.13, 0.45], [0.96, 0.62], [0.68, 0.67], [0.5, 0.56], [0.48, 0.41]], true),
      C([[0.6, 0.35], [0.85, 0.31], [1.05, 0.36]]),
      C([[0.56, 0.43], [0.84, 0.4], [1.07, 0.44]]),
      C([[0.56, 0.51], [0.82, 0.49], [1.02, 0.52]]),
      C([[0.62, 0.59], [0.82, 0.58], [0.95, 0.59]]),
      // The brainstem: the pons's curve in front, the line behind.
      C([[0.28, 0.38], [0.19, 0.5], [0.22, 0.63], [0.3, 0.76], [0.32, 0.95]]),
      C([[0.48, 0.49], [0.45, 0.66], [0.44, 0.95]])
    ];
    SH.push(scene([-0.66, -0.42], P));

    // 1. One long curve that never settles.
    var tang = [];
    for (i = 0; i <= 2400; i++) {
      var a = i / 2400 * Math.PI * 2 * 7;
      tang.push([0.62 * Math.cos(a) + 0.42 * Math.cos(a * 2.71 + 0.4) + 0.14 * Math.cos(a * 5.3),
                 0.5 * Math.sin(a) + 0.32 * Math.sin(a * 2.71 + 0.4) + 0.12 * Math.sin(a * 4.1)]);
    }
    SH.push(scene([0.08, 0.04], [tang], SH[0]));

    // 2 and 3. The author's circle, the world's with its people, the line;
    // then the compass construction that bridges it.
    var inner = [[0.42, -0.22, 0.12], [0.8, -0.18, 0.1], [0.55, 0.25, 0.14], [0.86, 0.26, 0.08]].map(function (q) { return ringP(q[0], q[1], q[2]); });
    var A = -0.55, B = 0, rr = 0.42, m = (A + B) / 2, hy = Math.sqrt(rr * rr - Math.pow((B - A) / 2, 2));
    SH.push(scene([-0.85, 0], [ringP(-0.85, 0, 0.3), ringP(0.62, 0, 0.62)].concat(inner, [[[A, 0], [-0.18, 0], [-0.18, -0.05], [-0.18, 0.05]]]), SH[1]));
    SH.push(scene([-0.85, 0], [ringP(-0.85, 0, 0.3), ringP(0.62, 0, 0.62)].concat(inner, [seg(A, 0, B, 0), seg(m, -hy - 0.12, m, hy + 0.12),
      arcP(A, 0, rr, -1.25, 2.5), arcP(B, 0, rr, Math.PI - 1.25, 2.5)]), SH[2]));

    // 4. Words, and a spiral of quarter circles.
    P = [];
    [[0.22, 0.12, 0.3, 0.16], [0.14, 0.28, 0.1, 0.2], [0.3, 0.12, 0.22], [0.18, 0.24]].forEach(function (row, ri) {
      var x = -1.25, y = -0.45 + ri * 0.3;
      row.forEach(function (w) { P.push(seg(x, y, x + w, y)); x += w + 0.07; });
    });
    var spiral = [], r = 0.62, ox = 0.62, oy = 0.05, ang = Math.PI;
    for (k = 0; k < 7; k++) {
      spiral = spiral.concat(arcP(ox, oy, r, ang, Math.PI / 2).slice(k ? 1 : 0));
      var na = ang + Math.PI / 2, nr = r / 1.618;
      ox += Math.cos(na) * (r - nr); oy += Math.sin(na) * (r - nr); ang = na; r = nr;
    }
    P.push(spiral);
    SH.push(scene([ox, oy], P, SH[3]));

    // 5. A horizon, rails and lines to one vanishing point, arches on the rails.
    var vx = 0.2, vy = -0.2, xl = -1.2, xr = -0.62;
    P = [seg(-1.3, vy, 1.3, vy), seg(vx, vy, xl, 1), seg(vx, vy, xr, 1)];
    [0.1, 0.55, 0.95, 1.3].forEach(function (x) { P.push(seg(vx, vy, x, 1)); });
    for (k = 0; k < 6; k++) {
      var s = Math.pow(0.7, k), by = vy + (1 - vy) * s, al = vx + (xl - vx) * s, ar = vx + (xr - vx) * s, h2 = 0.72 * s;
      P.push([[al, by]].concat(arcP((al + ar) / 2, by - h2, (ar - al) / 2, Math.PI, Math.PI), [[ar, by]]));
    }
    SH.push(scene([vx, vy], P, SH[4]));

    // 6. People, each circle left unclosed.
    SH.push(scene([0, 0], FOLK.map(function (q, j) { return arcP(q[0], q[1], q[2], j * 0.9, Math.PI * 2 * 0.72); }), SH[5]));

    // 7. Ripples crowding to one side, hardly reaching the other.
    P = [];
    for (k = 1; k <= 13; k++) P.push(arcP(0.32, 0, 0.075 * k, Math.PI / 2 + 0.12, Math.PI - 0.24));
    P.push(arcP(0.32, 0, 0.13, -Math.PI / 2 + 0.55, Math.PI - 1.1));
    SH.push(scene([0.32, 0], P, SH[6]));

    // 8. The people closed, each joined to the author by a measured line.
    P = FOLK.map(function (q) { return ringP(q[0], q[1], q[2]); });
    FOLK.forEach(function (q) {
      var L = Math.hypot(q[0], q[1]), ux = q[0] / L, uy = q[1] / L, a0 = 0.09, a1 = L - q[2] - 0.03, at = [];
      for (var t = a0 + 0.12; t < a1 - 0.04; t += 0.12) at.push(t - a0);
      P.push(ticked(ux * a0, uy * a0, ux * a1, uy * a1, at, 0.025));
    });
    SH.push(scene([0, 0], P, SH[7]));

    // 9. A journey of curiosity: a path spiralling out, evenly, from the
    // lamp at its centre, past the people met along it, left open; the
    // author at its open end, still going.
    var turns = 3.25, gap = 0.27, r0 = 0.3, phi0 = -Math.PI / 4, sq = 0.85, sp = [];
    var at = function (t) { var th = t * turns * Math.PI * 2, r = r0 + gap * th / (Math.PI * 2); return [Math.cos(th + phi0) * r, Math.sin(th + phi0) * r * sq, th, r]; };
    for (var u = 0; u <= 1.0001; u += 1 / 900) sp.push(at(u).slice(0, 2));
    var end = sp[sp.length - 1];
    P = [sp];
    [0.3, 0.42, 0.53, 0.63, 0.72, 0.8, 0.88].forEach(function (u, j) {
      var q = at(u), r9 = 0.065 + 0.008 * j, nx = Math.cos(q[2] + phi0), ny = Math.sin(q[2] + phi0) * sq, nl = Math.hypot(nx, ny);
      P.push(ringP(q[0] + nx / nl * (r9 + 0.025), q[1] + ny / nl * (r9 + 0.025), r9));
    });
    SH.push(scene(end, P, SH[8]));
  }

  function size() {
    W = pin.clientWidth; H = pin.clientHeight;
    if (!W || !H) return;
    dpr = Math.min(2, devicePixelRatio || 1);
    canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
    // The picture's column: from the sentence's right edge to the frame's
    // right edge (the axis), so on a very wide screen it stays inside the
    // page's frame instead of drifting to the window's far side.
    var tx = acts.length ? acts[0].firstElementChild : null;
    if (tx && W >= 761) {
      var L = tx.offsetLeft, R = L + tx.offsetWidth;
      colL = R + Math.max(24, W * 0.02); colW = Math.max(200, (W - L) - colL);
    } else { colL = 0; colW = W; }
    build();
    kick();
  }

  function ease(t) { t = Math.max(0, Math.min(1, t)); return t * t * t * (t * (t * 6 - 15) + 10); }
  function lerp(a, b, t) { return a + (b - a) * t; }

  // The site's lamp, from its own mark in the header.
  var LAMP = (function () {
    var dots = new Path2D();
    [38, 42.8, 47.6, 52.4, 57.2, 62].forEach(function (x) { dots.moveTo(x + 1.5, 88); dots.ellipse(x, 88, 1.5, 2.4, 0, 0, Math.PI * 2); });
    return {
      ink: new Path2D('M50 52 C46 40 60 36 56 26 C52 16 40 20 44 30 C47 37 58 32 60 22 C62 12 54 6 48 8'),
      pot: new Path2D('M39.2 94 C29.6 94 28.4 79.6 36.8 72.4 C40.4 69.4 41.6 67.6 41.6 64 L58.4 64 C58.4 67.6 59.6 69.4 63.2 72.4 C71.6 79.6 70.4 94 60.8 94 Z'),
      lid: new Path2D('M42.8 64 L42.8 59.2 L57.2 59.2 L57.2 64 Z'),
      band: new Path2D('M33.2 82 C40.4 78.4 59.6 78.4 66.8 82'),
      dots: dots
    };
  })();
  var F;
  function frame() {
    var narrow = W < 761, s = cur * N;
    var open = ease(s / 0.35);
    var intro = reduce ? 1 : ease((performance.now() - born) / 1800);
    // On a phone the drawing takes all the height the sentence leaves, and
    // follows it smoothly as sentences of different lengths come and go.
    var rt = 0, rh = H, settling = false;
    if (narrow) {
      var ai = s < 0.45 ? -1 : Math.min(N - 1, Math.floor(s + 0.55) - 1);
      var el = ai < 0 ? who : acts[ai].firstElementChild;
      var target = (el ? el.offsetTop : H * 0.55) - (ai < 0 ? 4 : 18);
      if (!regB) regB = target;
      regB += (target - regB) * 0.16;
      settling = Math.abs(target - regB) > 0.5;
      rt = 10; rh = Math.max(120, regB - rt);
    }
    var S0 = narrow ? Math.min(W * 0.9 / 2.7, rh * 0.86 / 2.1) : Math.min(colW * 0.86 / 2.7, H * 0.68 / 2.1);
    // The change under way, from scene k - 1 to scene k, in the middle of
    // the scroll between their sentences. The sentence changes halfway.
    var k = Math.max(0, Math.min(N, Math.floor(s + 0.85)));
    var w = k === 0 ? 1 : (s - (k - 0.85)) / 0.6;
    F = {
      narrow: narrow, intro: intro, settling: settling, k: k, w: Math.max(0, Math.min(1, w)), S: S0,
      cx: narrow ? W * 0.5 : colL + colW * lerp(0.62, 0.5, open), cy: narrow ? rt + rh / 2 : H * 0.5
    };
  }

  function draw(now) {
    raf = 0;
    // A mouse wheel moves the page in jumps of a hundred pixels or so; the
    // drawing glides after the scroll instead of jumping with it, at the
    // same pace whatever the screen's refresh rate.
    var dt = last ? Math.min(64, (now || performance.now()) - last) : 16;
    last = now || performance.now();
    cur = reduce ? prog : cur + (prog - cur) * (1 - Math.exp(-dt / 110));
    if (Math.abs(prog - cur) < 0.0004) cur = prog;
    frame();
    var k = F.k, w = F.w, narrow = F.narrow, S = F.S, cx = F.cx, cy = F.cy;
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    g.clearRect(0, 0, W, H);
    g.lineCap = 'round'; g.lineJoin = 'round';

    var A = SH[k > 0 ? k - 1 : 0], B = SH[k], mix = k > 0 && w < 1;
    // Every line, always drawn in full; between drawings each moves into
    // its next place, from one end to the other, a moment behind itself.
    var path = new Path2D();
    for (var j = 0; j < K; j++) {
      var a = A.s[j], b = B.s[j];
      for (var i = 0; i < NP; i++) {
        var x, y;
        if (mix) {
          var ww = ease(w * 1.3 - (i / NP) * 0.3);
          x = lerp(a[i][0], b[i][0], ww); y = lerp(a[i][1], b[i][1], ww);
        } else { x = b[i][0]; y = b[i][1]; }
        x = cx + x * S; y = cy + y * S;
        if (i === 0) path.moveTo(x, y); else path.lineTo(x, y);
      }
    }
    g.lineWidth = narrow ? 1 : 1.1;
    g.strokeStyle = pal.ink; g.globalAlpha = F.intro;
    g.stroke(path);

    // The author: one small circle in the signal colour, always there,
    // moving with the scene.
    var mt = mix ? ease(w) : 1, ma = A.me, mb = B.me;
    var mx = cx + lerp(ma[0], mb[0], mt) * S, my = cy + lerp(ma[1], mb[1], mt) * S;
    // In the last drawing the site's lamp stands at the spiral's centre,
    // where the journey starts; the author stays at its open end.
    var lamp = k === SH.length - 1 ? (mix ? ease(w) : 1) : 0;
    g.globalAlpha = F.intro;
    g.strokeStyle = pal.accent; g.fillStyle = pal.accent; g.lineWidth = narrow ? 1 : 1.1;
    g.beginPath(); g.arc(mx, my, 0.06 * S, 0, Math.PI * 2); g.stroke();
    g.beginPath(); g.arc(mx, my, narrow ? 2 : 2.4, 0, Math.PI * 2); g.fill();
    if (lamp > 0.01) {
      var sc = 0.4 * S / 96, lx = cx, ly = cy + 0.14 * S;
      g.globalAlpha = lamp;
      g.setTransform(dpr * sc, 0, 0, dpr * sc, dpr * (lx - 50 * sc), dpr * (ly - 94 * sc));
      g.lineCap = 'round'; g.lineJoin = 'round'; g.strokeStyle = pal.accent;
      g.lineWidth = 3.4; g.stroke(LAMP.ink);
      g.fillStyle = pal.bg; g.fill(LAMP.pot); g.lineWidth = 3; g.stroke(LAMP.pot);
      g.fillStyle = pal.accent; g.lineWidth = 1.5; g.fill(LAMP.lid); g.stroke(LAMP.lid);
      g.lineWidth = 1.6; g.stroke(LAMP.band);
      g.fill(LAMP.dots);
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    g.globalAlpha = 1;

    // The sentence changes halfway through its scene's change.
    var s3 = cur * N, act = s3 < 0.45 ? -1 : Math.min(N - 1, Math.floor(s3 + 0.55) - 1);
    acts.forEach(function (el, i) { el.classList.toggle('on', i === act); });
    ticks.forEach(function (el, i) { el.classList.toggle('on', i === act); });
    if (who) who.classList.toggle('on', act < 0);
    if (hint) hint.classList.toggle('gone', prog > 0.02);

    var busy = F.intro < 1 || F.settling || cur !== prog;
    if (busy) kick(); else last = 0;
  }

  function kick() { if (!raf && SH.length) { raf = requestAnimationFrame(draw); } }

  function onScroll() {
    // Measured from where the picture pins (under the header), so the last
    // step lands exactly as the picture lets go, not after it has moved.
    var b = stage.getBoundingClientRect(), stick = parseFloat(getComputedStyle(pin).top) || 0;
    var total = stage.offsetHeight - pin.offsetHeight;
    prog = Math.max(0, Math.min(1, (stick - b.top) / (total || 1)));
    if (!started) { cur = prog; started = true; }
    kick();
  }
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('pointermove', function (e) {
    if (e.pointerType === 'touch') return;
    tyaw = (e.clientX / innerWidth - 0.5) * 1.1;
    tpit = (e.clientY / innerHeight - 0.5) * 0.5;
    kick();
  }, { passive: true });
  new ResizeObserver(function () { size(); onScroll(); }).observe(pin);
  new MutationObserver(function () { palette(); kick(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  palette(); size(); onScroll();
})();
</script>
