---
import { img, share, widths } from '../lib/media';
/* Blogs: the Index. Everything written, as one wall of words and one
   table of huge titles. (The data below is the same as ever: essays and
   notebooks, their words counted from their own sources.)

   One timeline, newest first, under clear year headings. Every piece is the
   same row: its date in the margin, its figure at full width, what it is,
   its title and what it asks.
   The one difference is the honest one: an essay is a single piece, a
   notebook is a run of days, and its row lists them quietly, each a link.

   An essay is one piece, read in one sitting. A notebook is a thread of
   short days on one question, each day its own short read. They share a
   single list, newest first, with every reading time stated. */

import Layout from '../layouts/Layout.astro';
import { wordsIn } from '../lib/text';

import { notebooks } from '../lib/notebooks';

/* Words in each essay, from its own source: markup, code and maths out. */
const essaySources = import.meta.glob(['./blog/*.astro', './sign-language-recognition-using-cnn-and-opencv.astro'], { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const essayWords: Record<string, number> = Object.fromEntries(Object.entries(essaySources).map(([path, raw]) =>
  [path.split('/').pop()!.replace('.astro', ''), wordsIn(raw)]));
const totalWords = Object.values(essayWords).reduce((a, b) => a + b, 0) + notebooks.reduce((a, nb) => a + nb.words, 0);
const wordsLabel = (n: number) => (n > 0 ? `${n.toLocaleString('en-US')} words · ` : '');

const title = "Technical Blogs — Arshad Kazi";

// `contents` mirrors the section headings inside each post, so the index says
// what a post actually covers instead of making you open it to find out.
const posts = ([
  {
    title: "Probability Mass Functions, Expectation, and Variance",
    date: "2023-11-15",
    description: "Relearning probability from a machine learning perspective. What PMFs are, how to compute expectation and variance from first principles, and why any of this matters for ML.",
    tags: ["probability", "statistics", "PMF", "machine learning", "fundamentals"],
    slug: "probability-mass-function",
    minutes: 5,
    contents: [
      "What is Probability?",
      "Probability Distribution",
      "Probability Mass Function",
      "Expected Value (Expectation)",
      "Variance",
      "Why does any of this matter for ML?",
    ],
  },
  {
    title: "ROC Curves and AUC: Picking the Right Threshold for Your Model",
    date: "2024-02-01",
    description: "Why accuracy fails on skewed data, how confusion matrices work, and how to use ROC curves and AUC to evaluate and compare probabilistic classifiers.",
    tags: ["machine learning", "evaluation", "ROC", "AUC", "classification"],
    slug: "roc-curve-auc",
    minutes: 5,
    contents: [
      "Why Accuracy Is Not Enough",
      "True Positive, True Negative, False Positive, False Negative",
      "Confusion Matrix",
      "ROC Curve",
      "AUC (Area Under the Curve)",
    ],
  },
  {
    title: "Building a Sign Language Recognition System with CNNs and OpenCV",
    date: "2024-03-10",
    description: "A practical walkthrough of building a real-time ASL alphabet recogniser. Dataset, CNN architecture with the actual math, and live webcam inference using OpenCV.",
    tags: ["computer vision", "CNN", "sign language", "OpenCV", "keras", "deep learning"],
    slug: "sign-language-recognition-using-cnn-and-opencv",
    href: "/sign-language-recognition-using-cnn-and-opencv",
    minutes: 5,
    contents: [
      "Dataset",
      "Build and Train the Model",
      "OpenCV",
    ],
  },
  {
    title: "Vector Database Management Systems: Architecture and Internals",
    date: "2024-01-15",
    description: "A technical overview of how Vector Database Management Systems work, covering vectorization, indexing, hardware tradeoffs, and the core challenges in building systems that search by meaning rather than exact match.",
    tags: ["vector databases", "VDBMS", "embeddings", "similarity search", "machine learning systems"],
    slug: "vector-databases-vdbms",
    minutes: 6,
    contents: [
      "What is a Vector Database?",
      "Why Not a Regular Database?",
      "General Architecture of a VDBMS",
      "Use Cases",
      "Challenges and Limitations",
    ],
  },
  {
    title: "The Visual Cortex as a Computer Vision Architecture: Dorsal and Ventral Streams",
    date: "2026-04-05",
    description: "How the brain's visual cortex uses two parallel streams, feedback loops, and relative perception to process vision. Everything rewritten for engineers who build vision systems.",
    tags: ["computer vision", "neuroscience", "visual cortex", "CNN", "architecture"],
    slug: "cnns-design-flaw-evolution",
    minutes: 15,
    contents: [
      "The Split You Did Not Know Was in Your Design",
      "The Dorsal Stream: Real-Time Spatial Inference",
      "The Ventral Stream: Hierarchical Object Recognition",
      "Implications for Computer Vision Engineering",
    ],
  },
  {
    title: "Temporal and Spatial Attention for 3D Pose Estimation",
    date: "2026-02-22",
    description: "How temporal and spatial attention mechanisms enable accurate 2D-to-3D human pose estimation, with a deep dive into DSTformer.",
    tags: ["pose estimation", "attention", "3D vision", "transformers"],
    slug: "temporal-spatial-attention-3d-pose",
    minutes: 6,
    contents: [
      "The Ill-Posed Problem: Lifting 2D to 3D",
      "Temporal Attention: Understanding Motion Over Time",
      "Spatial Attention: Maintaining Anatomical Consistency",
      "Fusion of Temporal and Spatial Streams",
    ],
  },
]).sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

type Item =
  | { kind: 'essay'; date: string; title: string; description: string; href: string; image: string; src: string; minutes: number; words: number; tags: string[]; contents: string[] }
  | { kind: 'notebook'; date: string; title: string; description: string; href: string; image: string; src: string; minutes: number; tags: string[]; nb: (typeof notebooks)[number] };

const items: Item[] = [
  ...posts.map(p => ({
    kind: 'essay' as const, date: p.date, title: p.title, description: p.description,
    href: p.href || `/blog/${p.slug}`, image: img(`/images/blog/${p.slug}.jpg`, 960), src: `/images/blog/${p.slug}.jpg`,
    minutes: essayWords[p.slug] ? Math.max(1, Math.round(essayWords[p.slug] / 230)) : p.minutes, words: essayWords[p.slug] ?? 0, tags: p.tags, contents: p.contents,
  })),
  ...notebooks.map(nb => ({
    kind: 'notebook' as const, date: nb.endDate, title: nb.title, description: nb.description,
    href: `/notebooks/${nb.slug}`, image: img(`/images/blog/notebook-${nb.slug}.jpg`, 960), src: `/images/blog/notebook-${nb.slug}.jpg`,
    minutes: nb.minutes, tags: nb.tags, nb,
  })),
].sort((a, b) => b.date.localeCompare(a.date));

// Topics worth filtering by: the ones that more than one piece shares.
/* A handful of plain topics, as on Thoughts, in place of the raw tags:
   each is the set of tags that mean it, and a piece belongs to every
   topic one of its tags falls under. */
const TOPICS: [string, string[]][] = [
  ['Vision', ['computer vision', '3D vision', 'pose estimation', 'visual cortex', 'OpenCV', 'sign language']],
  ['The brain', ['neuroscience', 'psychology', 'perception', 'visual cortex', 'autism']],
  ['Neural networks', ['deep learning', 'CNN', 'transformers', 'attention', 'LLMs']],
  ['Search & embeddings', ['embeddings', 'vector databases', 'similarity search', 'multimodal']],
  ['Probability & evaluation', ['probability', 'statistics', 'evaluation', 'ROC', 'AUC', 'PMF']],
];
const topicsOf = (tags: string[]) => TOPICS.filter(([, ts]) => ts.some(t => tags.includes(t))).map(([n]) => n);
const topics = TOPICS.map(([n]) => ({ name: n, count: items.filter(it => topicsOf(it.tags).includes(n)).length })).filter(t => t.count > 0);


const fmt = (d: string, o: Intl.DateTimeFormatOptions) => new Date(d + 'T00:00:00').toLocaleDateString('en-US', o);
const short = (d: string) => fmt(d, { month: 'short', day: 'numeric' });
const years = [...new Set(items.map(it => it.date.slice(0, 4)))];

/* The work in four topics, so a page of wide interests reads as four
   clear bodies of work. Each has its own drawings from the history of
   looking, which form beside its name as you reach it. In each, notebooks lead (the one being written first),
   then essays, newest first. */
const keyOf = (it: Item) => it.href.split('/').filter(Boolean).pop()!;
const TOPIC_DEFS = [
  { id: 'vision', intro: 'Recovering structure from projections. An image discards depth, so every estimate of shape, motion and identity is an inference under geometric and statistical constraints.', set: [15, 10, 7, 3, 30, 31, 32], name: 'Vision', line: 'How a machine recovers the world from pixels: geometry, pose and recognition.', keys: ['3d-reconstruction', 'temporal-spatial-attention-3d-pose', 'sign-language-recognition-using-cnn-and-opencv'] },
  { id: 'neuroscience', intro: 'Computation in biological hardware: spiking neurons, hierarchies of receptive fields and dense feedback, doing inference on roughly twenty watts.', set: [13, 14, 20, 17, 18, 33, 34, 35, 36], name: 'Neuroscience', line: 'How the brain sees, and how it feels: the computation behind both.', keys: ['neuroscience', 'cnns-design-flaw-evolution', 'emotion'] },
  { id: 'machine-learning', intro: 'Function approximation at scale. Parameterised models fitted by gradient descent, where the architecture decides what can be represented and the data decides what is learned.', set: [5, 8, 0, 37, 38, 39], name: 'Machine learning', line: 'Transformers, models that read images, and search by meaning, derived from the ground up.', keys: ['modern-nets', 'vlm-search', 'vector-databases-vdbms'] },
  { id: 'foundations', intro: 'Probability, estimation and evaluation: the formal machinery for reasoning under uncertainty, and for deciding whether a model\'s output can be trusted.', set: [1, 4, 6, 11, 16, 22, 27, 28, 29, 40, 41], name: 'Foundations', line: 'The probability and evaluation everything above stands on.', keys: ['probability-mass-function', 'roc-curve-auc'] },
];
const rank = (it: Item) => (it.kind === 'notebook' ? (it.nb.inProgress ? 0 : 1) : 2);
const fields4 = TOPIC_DEFS.map(t => {
  const its = t.keys.map(k => items.find(it => keyOf(it) === k)!).filter(Boolean)
    .sort((a, b) => rank(a) - rank(b) || b.date.localeCompare(a.date));
  const words = its.reduce((n, it) => n + (it.kind === 'essay' ? it.words : it.nb.words), 0);
  return { ...t, items: its, words, notebooks: its.filter(x => x.kind === 'notebook').length, essays: its.filter(x => x.kind === 'essay').length };
});
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII'];
const k1 = (n: number) => `${(n / 1000).toFixed(1).replace('.0', '')}k`;
const mon = (d: string) => fmt(d, { month: 'short', year: 'numeric' });

/* ── The Index ─────────────────────────────────────────────── */
// Numbered in the order they were written, so a number never changes when
// something new arrives; listed newest first.
const chrono = [...items].sort((a, b) => a.date.localeCompare(b.date));
const numOf = (it: Item) => String(chrono.indexOf(it) + 1).padStart(2, '0');
const fieldOf = (it: Item) => fields4.find(f => f.keys.includes(keyOf(it)));
const wordsOf = (it: Item) => (it.kind === 'essay' ? it.words : it.nb.words);
const allWords = items.reduce((n, it) => n + wordsOf(it), 0);
const firstYear = chrono[0].date.slice(0, 4);
const lastYear = chrono[chrono.length - 1].date.slice(0, 4);

// The wall: every section of every essay and every written day of every
// notebook, as one passage. Each phrase links to its place.
const wall = items.flatMap(it => {
  const f = fieldOf(it)?.id ?? '';
  return it.kind === 'essay'
    ? it.contents.map((c, j) => ({ t: c, href: `${it.href}#section-${j + 1}`, key: keyOf(it), f }))
    : it.nb.days.filter(d => d.href).map(d => ({ t: d.title, href: d.href!, key: keyOf(it), f }));
});

---
<Layout title={title} activeNav="/blog" description="Essays and day-by-day notebooks in four topics: vision, neuroscience, machine learning and their foundations. Notes on things I finally understood, not tutorials." ogImage={share("/images/share-blog.jpg")}>
  <div class="ix" id="ix">

    <!-- ── The opening: a sentence you finish, over a wall of everything written. -->
    <section class="ix-open">
      <p class="ix-strip">
        <span><b>Index</b> of works</span>
        <span>{items.length} pieces</span>
        <span>{k1(allWords)} words</span>
        <span>{firstYear}&thinsp;&rarr;&thinsp;{lastYear}</span>
      </p>

      <h1 class="ix-title">
        <span class="ix-title-a">Technical</span>
        <label class="ix-ask">
          <span class="visually-hidden">Search everything written</span>
          <input type="search" id="ix-q" placeholder="Blogs" autocomplete="off" enterkeyhint="search" spellcheck="false" />
          <span class="ix-key" aria-hidden="true"><kbd>/</kbd> to search</span>
        </label>
      </h1>

      <p class="ix-wall" id="ix-wall" aria-label="Every section and every day, as one passage">
        {wall.map(w => <Fragment><a href={w.href} data-key={w.key} data-f={w.f}>{w.t}</a><span class="sl" aria-hidden="true"> / </span></Fragment>)}
      </p>
      <button type="button" class="ix-wall-more" id="ix-wall-more" aria-controls="ix-wall" aria-expanded="false">All {wall.length} sections and days</button>
    </section>

    <!-- ── The switches: the four fields, pinned while the list scrolls by. -->
    <nav class="ix-bar" aria-label="Fields">
      <button type="button" class="on" data-f="">All<sup>{items.length}</sup></button>
      {fields4.map(f => <button type="button" data-f={f.id}>{f.name}<sup>{f.items.length}</sup></button>)}
      <span class="ix-count" id="ix-count" aria-live="polite"></span>
    </nav>

    <!-- ── The table: one huge title to a row. -->
    <ol class="ix-list" id="ix-list">
      {items.map(it => {
        const f = fieldOf(it);
        const text = [it.title, it.description, f?.name ?? '', ...it.tags, ...(it.kind === 'essay' ? it.contents : it.nb.days.map(d => d.title))].join(' ').toLowerCase();
        return (
          <li class={`row ${it.kind}`} id={keyOf(it)} data-key={keyOf(it)} data-f={f?.id ?? ''} data-text={text}>
            <a class="row-link" href={it.href}>
              <span class="row-no"><b>{numOf(it)}</b><i>{it.date.slice(0, 4)}</i></span>
              <span class="row-print" aria-hidden="true"><img src={it.image} srcset={widths(it.src, [480, 720, 960])} sizes="(max-width: 760px) calc(100vw - 2.5rem), 22vw" alt="" width="1600" height="840" loading="lazy" decoding="async" /></span>
              <span class="row-main">
                <span class="row-title">{it.title}</span>
                <span class="row-desc">{it.description}</span>
              </span>
              <span class="row-meta">
                <span class="row-kind">{it.kind === 'essay' ? 'Essay' : 'Notebook'}{it.kind === 'notebook' && it.nb.inProgress && <em> · live</em>}</span>
                <span>{it.kind === 'essay' ? `${it.minutes} min` : `${it.nb.days.length} days · ${it.minutes} min`}</span>
                <span>{k1(wordsOf(it))} words</span>
                <span class="row-field">{f?.name}</span>
              </span>
            </a>
            {it.kind === 'notebook' && (
              <ol class="row-days" aria-label={`Days of ${it.title}`}>
                {it.nb.days.map(d => <li>{d.href
                  ? <a href={d.href} title={d.title}>{String(d.day).padStart(2, '0')}</a>
                  : <span title="Not written yet">{String(d.day).padStart(2, '0')}</span>}</li>)}
              </ol>
            )}
          </li>
        );
      })}
    </ol>
    <p class="ix-none" id="ix-none" hidden>Nothing written on that yet. <button type="button" id="ix-reset">Show everything</button></p>

    <details class="why ix-why">
      <summary>Why I write these</summary>
      <div class="why-body">
        <p>I write these to check whether I actually understand something. If I can explain it from the start, with the reasoning and not just the result, I do. If I can't, the gap shows up on the page.</p>
        <p>I'm mostly self-taught, so I don't always know what I'm missing. Writing is how I find out.</p>
        <p>I move between subjects because that's how my curiosity works, and because an idea often makes more sense once I've seen it somewhere else.</p>
        <p>These are working notes, not tutorials. Some of it will be wrong. Where I'm not sure, I say so.</p>
      </div>
    </details>
  </div>

</Layout>

<style>
  /* ════════════════════════════════════════════════════════════════
     The Index.
     Not a list of cards: a table of contents for everything written,
     set the way a type specimen is. The mast ("Technical Blogs"), whose
     last word is the search: type, and your word takes its place. Under
     it a wall made of every
     section and every day. Then one enormous title to a row; the rows
     you are not pointing at go hollow, and the piece's print follows
     the pointer like a proof pulled from the press.
     ════════════════════════════════════════════════════════════════ */
  .ix {
    margin-inline: calc(-1 * var(--axis));
    padding-inline: var(--axis);
    max-width: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── The opening ── */
  .ix-open {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-xl);
  }

  /* A strip of measurements across the frame, like the edge of a proof. */
  .ix-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-lg);
    margin: 0;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .ix-strip b { font-weight: var(--fw-medium); color: var(--color-accent); }

  /* The sentence, finished by the reader: the search is its last word. */
  .ix-title {
    margin: var(--space-xl) 0 0;
    font-family: var(--font-display);
    font-size: var(--fs-display-xl);
    font-weight: var(--fw-display);
    line-height: var(--lh-mast);
    letter-spacing: var(--track-mast);
    color: var(--color-text);
  }
  .ix-title-a { display: block; margin-left: -0.04em; text-wrap: balance; }

  .ix-ask {
    position: relative;
    display: block;
    margin-top: 0.04em;
  }
  .ix-ask input {
    display: block;
    width: 100%;
    padding: 0 1.2em 0.08em 0;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    background: none;
    font: inherit;
    font-style: italic;
    font-weight: var(--fw-light);
    letter-spacing: var(--track-tight);
    color: var(--color-accent);
    caret-color: var(--color-accent);
    outline: none;
    transition: border-color var(--dur-base) ease;
    -webkit-appearance: none;
    appearance: none;
  }
  .ix-ask input::placeholder { color: var(--color-accent); opacity: 1; }
  .ix-ask input:focus::placeholder { opacity: 0.25; }
  .ix-ask input:focus { border-bottom-color: var(--color-accent); }
  .ix-ask input::-webkit-search-cancel-button { display: none; }
  .ix-key {
    position: absolute;
    right: 0;
    bottom: 0.35em;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-style: normal;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .ix-key kbd {
    margin-right: var(--space-1);
    padding: var(--space-0-5) var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    color: var(--color-text);
  }
  .ix-ask:focus-within .ix-key { opacity: 0; }

  /* The wall: every section heading and every notebook day, run together
     as one justified passage. Searching lights the phrases that match and
     lets the rest sink into the paper; pointing at one shows the shape of
     the piece it belongs to. */
  .ix-wall {
    position: relative;
    margin: var(--space-xl) 0 0;
    max-height: 9.6em;
    overflow: hidden;
    font-family: var(--font-serif);
    font-size: var(--fs-lead);
    line-height: var(--lh-ui);
    text-align: justify;
    hyphens: auto;
    color: var(--color-text-secondary);
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent);
    mask-image: linear-gradient(180deg, #000 55%, transparent);
  }
  .ix-wall.open {
    max-height: none;
    -webkit-mask-image: none;
    mask-image: none;
  }
  .ix-wall a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur-fast) ease, opacity var(--dur-fast) ease;
  }
  .ix-wall a:hover { color: var(--color-accent); }
  .ix-wall .sl { color: var(--color-accent); opacity: 0.55; }
  .ix-wall.pointing a:not(.hot), .ix-wall.searching a:not(.hit), .ix-wall a.off { opacity: 0.18; }
  .ix-wall a.hot { color: var(--color-text); }
  .ix-wall a.hit { color: var(--color-accent); font-style: italic; }

  .ix-wall-more {
    align-self: flex-start;
    margin-top: var(--space-3);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .ix-wall-more::before { content: '+ '; }
  .ix-wall-more[aria-expanded='true']::before { content: '− '; }

  /* ── The switches ── */
  .ix-bar {
    position: sticky;
    top: var(--head-h, 4.5rem);
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-6);
    margin: 0 calc(-1 * var(--axis));
    padding: var(--space-3) var(--axis);
    background: color-mix(in srgb, var(--color-bg) 86%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-border);
  }
  .ix-bar button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: var(--fs-lead);
    font-weight: var(--fw-light);
    color: var(--color-text-secondary);
    transition: color var(--dur-fast) ease;
  }
  .ix-bar button:hover { color: var(--color-text); }
  .ix-bar button.on { font-style: italic; color: var(--color-accent); }
  .ix-bar sup {
    margin-left: var(--space-0-5);
    font-family: var(--font-mono);
    font-size: var(--fs-micro);
    font-style: normal;
    color: var(--color-accent);
  }
  .ix-count {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ── The table ── */
  .ix-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    border-bottom: 1px solid var(--color-text);
  }
  .row[hidden] { display: none; }
  .row-link {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) clamp(11rem, 19vw, 24rem) 11rem;
    grid-template-areas: 'no main print meta';
    column-gap: var(--space-lg);
    align-items: start;
    padding: clamp(1.4rem, 3.4vw, 2.6rem) 0;
    color: inherit;
    text-decoration: none;
  }
  .row-link:hover { text-decoration: none; }

  .row-no {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: 0.9em;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-caps);
  }
  .row-no b { font-weight: var(--fw-medium); color: var(--color-accent); }
  .row-no i { font-style: normal; color: var(--color-text-muted); }

  .row-no { grid-area: no; }
  .row-main { grid-area: main; display: block; min-width: 0; }
  .row-meta { grid-area: meta; }

  /* Each piece's print, laid on the page a little askew, the way proofs
     lie on a table. Reached for, it straightens and lifts. */
  .row-print {
    grid-area: print;
    display: block;
    padding: var(--space-1);
    background: var(--color-raised);
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-soft);
    transform: rotate(var(--tilt, -1.5deg));
    transition: transform var(--dur-slow) var(--ease-out), box-shadow var(--dur-slow) var(--ease-out);
  }
  .row:nth-child(even) .row-print { --tilt: 1.5deg; }
  .row:nth-child(3n) .row-print { --tilt: -0.6deg; }
  .row-print img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1600 / 840;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .row-link:hover .row-print,
  .row-link:focus-visible .row-print {
    transform: rotate(0deg) translateY(calc(-1 * var(--space-1-5)));
    box-shadow: var(--shadow-lift);
  }

  .row-title {
    display: block;
    margin-left: -0.04em;
    font-family: var(--font-display);
    font-size: var(--fs-index);
    font-weight: var(--fw-display);
    line-height: var(--lh-display);
    letter-spacing: var(--track-mast);
    text-wrap: balance;
    color: var(--color-text);
    -webkit-text-stroke: 1px transparent;
    transition: color var(--dur-base) ease, -webkit-text-stroke-color var(--dur-base) ease, transform var(--dur-slow) var(--ease-out);
  }
  .row-desc {
    display: block;
    max-width: 58ch;
    margin-top: var(--space-4);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-ui);
    line-height: var(--lh-ui);
    color: var(--color-text-secondary);
  }

  .row-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
    padding-top: 0.9em;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    text-align: right;
    color: var(--color-text-muted);
  }
  .row-kind { color: var(--color-text); }
  .row-kind em { font-style: normal; color: var(--color-accent); }
  .row-field { color: var(--color-accent); }

  /* A notebook's days, as a strip of numbered frames. */
  .row-days {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1-5);
    list-style: none;
    margin: calc(-1 * var(--space-3)) 0 0;
    padding: 0 0 clamp(1.4rem, 3.4vw, 2.6rem) calc(6.5rem + var(--space-lg));
  }
  .row-days a, .row-days span {
    display: grid;
    place-items: center;
    min-width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--dur-fast) ease, color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .row-days a:hover { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-bg); text-decoration: none; }
  .row-days span { border-style: dashed; color: var(--color-text-muted); }

  /* Pointing: every other title goes hollow, the one reached for steps
     forward. */
  @media (hover: hover) and (min-width: 761px) {
    .ix-list:has(.row-link:hover) .row:not(:has(.row-link:hover)) .row-title {
      color: transparent;
      -webkit-text-stroke-color: color-mix(in srgb, var(--color-text) 40%, transparent);
    }
    .row-link:hover .row-title { transform: translateX(0.18em); }
    .row-link:hover .row-no b { color: var(--color-text); }
  }

  .ix-none {
    margin: var(--space-2xl) 0;
    font-family: var(--font-display);
    font-size: var(--fs-h2);
    font-weight: var(--fw-light);
    font-style: italic;
    color: var(--color-text-secondary);
  }
  .ix-none button {
    margin-left: var(--space-3);
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-style: normal;
    letter-spacing: var(--track-caps);
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .ix-why { margin-top: var(--space-2xl); }


  /* ── Tablets: the measurements move under the title ── */
  @media (min-width: 761px) and (max-width: 1100px) {
    .row-link {
      grid-template-columns: 4.5rem minmax(0, 1fr) clamp(10rem, 26vw, 16rem);
      grid-template-areas: 'no main print' '. meta print';
    }
    .row-meta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-1) var(--space-4);
      padding-top: var(--space-4);
      text-align: left;
    }
    .row-days { padding-left: calc(4.5rem + var(--space-lg)); }
  }

  /* ── Phones ── */
  @media (max-width: 760px) {
    .ix-open { padding-bottom: var(--space-lg); }
    .ix-strip { justify-content: flex-start; }
    .ix-title { margin-top: var(--space-xl); }
    .ix-wall { margin-top: var(--space-lg); font-size: var(--fs-ui); max-height: 12em; text-align: left; }

    .ix-bar {
      gap: var(--space-1) var(--space-4);
      padding-block: var(--space-2);
    }
    .ix-bar button { font-size: var(--fs-ui); }
    .ix-count { flex-basis: 100%; margin-left: 0; }

    .row-link {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'no' 'print' 'main' 'meta';
      row-gap: var(--space-3);
      padding: var(--space-xl) 0;
    }
    .row-no { flex-direction: row; gap: var(--space-3); padding-top: 0; }
    .row-meta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-1) var(--space-4);
      padding-top: 0;
      text-align: left;
    }

    .row-print { margin-bottom: var(--space-1); }

    .row-days { margin-top: 0; padding-left: 0; padding-bottom: var(--space-xl); }
  }
</style>

<script is:inline>
(function () {
  var ix = document.getElementById('ix');
  if (!ix) return;
  var q = document.getElementById('ix-q');
  var wall = document.getElementById('ix-wall');
  var more = document.getElementById('ix-wall-more');
  var rows = [].slice.call(ix.querySelectorAll('.row'));
  var phrases = [].slice.call(wall.querySelectorAll('a'));
  var bar = [].slice.call(ix.querySelectorAll('.ix-bar button'));
  var count = document.getElementById('ix-count');
  var none = document.getElementById('ix-none');
  var field = '';

  function openWall(open) {
    wall.classList.toggle('open', open);
    more.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  more.addEventListener('click', function () { openWall(!wall.classList.contains('open')); });

  function apply() {
    var term = q.value.trim().toLowerCase();
    var words = term.split(/\s+/).filter(Boolean);
    var shown = 0;
    rows.forEach(function (r) {
      var ok = (!field || r.dataset.f === field) && words.every(function (w) { return r.dataset.text.indexOf(w) !== -1; });
      r.hidden = !ok;
      if (ok) shown++;
    });
    wall.classList.toggle('searching', words.length > 0);
    phrases.forEach(function (a) {
      var t = a.textContent.toLowerCase();
      a.classList.toggle('hit', words.length > 0 && words.every(function (w) { return t.indexOf(w) !== -1; }));
      a.classList.toggle('off', !!field && a.dataset.f !== field);
    });
    if (words.length) openWall(true);
    none.hidden = shown > 0;
    count.textContent = (words.length || field) ? shown + ' of ' + rows.length : '';
  }

  q.addEventListener('input', apply);
  bar.forEach(function (b) {
    b.addEventListener('click', function () {
      field = b.dataset.f;
      bar.forEach(function (x) { x.classList.toggle('on', x === b); });
      apply();
    });
  });
  document.getElementById('ix-reset').addEventListener('click', function () {
    q.value = ''; field = '';
    bar.forEach(function (x, i) { x.classList.toggle('on', i === 0); });
    apply();
  });
  addEventListener('keydown', function (e) {
    if (e.key === '/' && !/INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName)) { e.preventDefault(); q.focus(); }
    if (e.key === 'Escape' && document.activeElement === q) { q.value = ''; apply(); q.blur(); }
  });

  // Pointing at a phrase shows every phrase of the same piece.
  wall.addEventListener('pointerover', function (e) {
    var a = e.target.closest('a');
    if (!a) return;
    wall.classList.add('pointing');
    phrases.forEach(function (p) { p.classList.toggle('hot', p.dataset.key === a.dataset.key); });
  });
  wall.addEventListener('pointerleave', function () {
    wall.classList.remove('pointing');
    phrases.forEach(function (p) { p.classList.remove('hot'); });
  });

})();
</script>
